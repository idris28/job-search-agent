# --- AI model: change these three lines to switch model or provider ---
LLM_PROVIDER=anthropic          # anthropic | openai  (optional: inferred from LLM_MODEL)
LLM_MODEL=claude-sonnet-5-5     # e.g. claude-opus-5-5, claude-haiku-5-5, gpt-5.4-mini
LLM_EFFORT=medium               # Claude only: low | medium | high | xhigh | max (optional)

# --- API keys: set the one for your provider ---
ANTHROPIC_API_KEY=              # console.anthropic.com -> Settings -> API Keys
OPENAI_API_KEY=                 # platform.openai.com/api-keys

# --- Database (required) ---
DATABASE_URL=postgresql://localhost/jobagent

# --- Browserbase: only needed for sources with kind: generic ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=         # optional; defaults to the API key's project

# --- Gmail: only needed for `jsa email --send` or `--gmail-drafts` ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=             # an app password from myaccount.google.com/apppasswords, not your login password

# --- Phone notifications (optional): a Telegram bot from @BotFather, and your chat id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional ---
# JOBAGENT_BROWSER=browserbase  # or "local" to use a local Chromium for development
# JOBAGENT_CONFIG=config.yaml
