# --- AI provider: set ONE of these keys ---
# Claude (Anthropic): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# OpenAI: platform.openai.com/api-keys
OPENAI_API_KEY=
# If both keys are set, choose with: LLM_PROVIDER=anthropic | openai  (default: openai)
# LLM_PROVIDER=anthropic

# --- Database (required) ---
DATABASE_URL=postgresql://localhost/jobagent

# --- Browserbase: only needed for sources with kind: generic ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Optional ---
# ANTHROPIC_MODEL=claude-opus-5-5   # e.g. claude-sonnet-5-5 or claude-haiku-5-5 to spend less
# ANTHROPIC_EFFORT=medium           # low | medium | high | xhigh | max
# OPENAI_MODEL=gpt-5.4-mini
# JOBAGENT_BROWSER=browserbase      # or "local" to use a local Chromium for development
# JOBAGENT_CONFIG=config.yaml
