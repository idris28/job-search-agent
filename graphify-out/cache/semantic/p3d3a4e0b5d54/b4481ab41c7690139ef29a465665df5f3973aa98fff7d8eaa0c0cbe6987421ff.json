, "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_data_shapes", "label": "Data shapes (src/jobagent/models.py)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_settings", "label": "Settings - .env secrets and config.yaml (src/jobagent/config.py)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_users_own_browser", "label": "User's own browser", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_jobposting", "label": "JobPosting - the one shape a job takes", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L142-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single shared shape: sources create it, filters read it, the database stores it, and the AI scores it."}, {"id": "architecture_basellm", "label": "BaseLLM - every AI task lives in one base class", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L144-L145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Claude and OpenAI classes only supply how to call each provider, so one line in .env switches between them."}, {"id": "architecture_database_as_only_meeting_point", "label": "The four parts meet only in the database", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L146-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each command reads what an earlier one stored; that is why a job added with jsa add can be emailed without a run, and why re-running never scores or emails a job twice."}, {"id": "architecture_nothing_reaches_recruiter_by_accident", "label": "Nothing reaches a recruiter by accident", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L148-L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A draft is saved before delivery is attempted, and delivery happens only with --gmail-drafts or --send."}, {"id": "architecture_agent_never_logs_in", "label": "The agent never logs in to job sites", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L150-L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Job sites block automated browsers, so applying on a site is done by the user in their own browser."}, {"id": "architecture_fingerprint_dedup", "label": "Fingerprint dedup and match-hash skip (upsert_job, existing_match_hash)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L44-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jobs are stored once by fingerprint and jobs already scored are skipped, so re-running never scores a job twice."}, {"id": "architecture_shortlist_threshold", "label": "Shortlist threshold - score 75 or more", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_parallel_scoring", "label": "Parallel scoring - up to 4 jobs at a time (score_job)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L50-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_session_retry", "label": "Browser session retry - new session opened and page retried", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the Browserbase session ends mid-run, a new one is opened and the page is retried so the run survives."}, {"id": "architecture_listing_extraction", "label": "Listing extraction (extract_listings) - hallucinated links dropped, newest first, up to 15 job pages", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L37-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links not on the page are dropped to guard against invented URLs; newest jobs are opened first and at most 15 job pages are fetched."}, {"id": "architecture_pasted_job_reading", "label": "Pasted job reading (read_pasted_job)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L63-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_recruiter_email_drafting", "label": "Recruiter email drafting (recruiter_email with email_template.txt, unfilled_placeholders)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": "L80-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "architecture_ready_criteria", "label": "Ready-to-deliver criteria (address on posting, posting open, no blank left, not already applied)", "file_type": "rationale", "source_file": "ARCHITECTURE.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An email is delivered only when the posting has an address, is still open, the draft has no unfilled placeholder, and the job is not already applied to."}, {"id": "architecture_application_status", "label": "Application status tracking (set_application_status: applied or skipped)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "s